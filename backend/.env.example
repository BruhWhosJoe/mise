# Copy to backend/.env (or project-root .env) and adjust.
# backend/.env is git-ignored: your key stays on your machine. After editing
# it, restart the backend. Never put secrets in frontend code or VITE_ vars.
# On Render, PORT is injected automatically and MF_MODEL_API_KEY is the only
# required setting (add it as a secret env var); the rest have defaults.
MF_MCP_URL=https://ca-metadata-mcp-dev.wittyforest-26c063ae.eastus.azurecontainerapps.io/mcp
MF_MCP_TIMEOUT_SECONDS=20
MF_PREVIEW_DEFAULT_LIMIT=20
MF_PREVIEW_MAX_LIMIT=100
MF_BACKEND_HOST=127.0.0.1
MF_BACKEND_PORT=8001

# --- AI discovery + recipe (Meta Muse Spark, documented at ---
# --- https://dev.meta.ai/docs/cookbook/quickstart-chat-completions) ---
# Get a key from Meta's developer platform (see backend/README.md), paste it
# below, and restart the backend. Without a key, catalog browsing keeps
# working but /api/discovery and /api/recipe answer 503 ai_not_configured.
MF_MODEL_API_KEY=
MF_MODEL_BASE_URL=https://api.meta.ai/v1
MF_MODEL_CHAT_PATH=/chat/completions
MF_MODEL_NAME=muse-spark-1.3
MF_MODEL_TIMEOUT_SECONDS=60
MF_MODEL_MAX_OUTPUT_TOKENS=3000
MF_MODEL_TEMPERATURE=0.2
MF_MODEL_MAX_RETRIES=1
# none | json_object | json_schema (json_schema is the documented default;
# drop to json_object if the provider ever rejects a request)
MF_MODEL_STRUCTURED_MODE=json_schema

# --- AI retrieval/ranking budgets ---
MF_DISCOVERY_CANDIDATES=80
MF_DISCOVERY_MAX_RESULTS=15
MF_EXPANSION_TIMEOUT_SECONDS=30
MF_RECIPE_MAX_DATASETS=10
MF_CATALOG_CACHE_SECONDS=900
MF_CATALOG_CACHE_MAX_RECORDS=5000
MF_CATALOG_PAGE_SIZE=100
MF_RECIPE_MAX_INPUT_CHARS=60000
